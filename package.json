{
  "name": "ha-dhe-connect-card",
  "version": "0.5.0",
  "description": "Mushroom-style Lovelace card for the Stiebel DHE Connect Home Assistant integration.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "check": "npm run i18n:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run compat && npm run license-check && npm run legal-check",
    "compat": "node scripts/compat_check.mjs",
    "docs-check": "vitest run test/catalog-docs.test.ts",
    "ha:live-entity-audit": "node scripts/ha_live_entity_audit.mjs",
    "ha:storage-smoke": "node scripts/ha_storage_smoke.mjs",
    "i18n:check": "node scripts/i18n_sync.mjs --check",
    "i18n:extract": "node scripts/i18n_sync.mjs --write",
    "license-check": "node scripts/license_check.mjs",
    "legal-check": "node scripts/legal_check.mjs",
    "lint": "eslint . --max-warnings=0",
    "readme-screenshots": "node scripts/readme_screenshots.mjs",
    "render-smoke": "npm run build && node scripts/render_smoke.mjs",
    "smoke": "node scripts/ha_card_smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "stiebel",
    "dhe-connect"
  ],
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.8.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "puppeteer-core": "^25.0.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
